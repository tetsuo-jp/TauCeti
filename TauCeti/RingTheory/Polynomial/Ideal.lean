module

public import Mathlib.RingTheory.Polynomial.Basic
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.Localization.Away.AdjoinRoot
import Mathlib.Tactic.ComputeDegree
import TauCeti.RingTheory.Localization.Ideal

/-!
# Ideal intersections and saturations by adjoining a variable

For ideals `I` and `J` of a commutative ring, their intersection is the contraction along
`Polynomial.C` of `X * I + (1 - X) * J`. Here multiplication by a polynomial means
multiplication by its principal ideal, and the ideals of coefficients are extended to the
polynomial ring. The generator version makes this a reduction of intersection to elimination.

The saturation of an ideal `I` by an element `r`, the set of `x` with `r ^ n * x ∈ I` for some
`n`, is the contraction along `Polynomial.C` of `I[X] + (r X - 1)`. Since `R[X] ⧸ (r X - 1)` is
the localization of `R` away from `r` (`Localization.awayEquivAdjoin`), this is the contraction of
`I` from that localization, so saturation is also reduced to elimination.

No field or Noetherian hypothesis is needed.

Finally, `Ideal.exists_poly_isRoot_mk_of_pow_four_dvd_cubic` bounds the residues modulo a prime
element `ϖ` of the solutions of a cubic congruence modulo `ϖ ^ 4` of the form
`(ϖ t)³ + a₂ (ϖ t)² + a₄ (ϖ t) + a₆` by the roots of a nonzero polynomial of degree at most `3`.

## References

* D. Cox, J. Little, D. O'Shea, *Ideals, Varieties, and Algorithms*, Chapter 4, §3,
  the added-variable construction for intersections of ideals, and Chapter 4, §4,
  the added-variable construction for saturations.
-/

public section

namespace Ideal

open Polynomial

variable {R : Type*} [CommRing R]

/-- The intersection of two ideals is obtained by eliminating the new variable from
`X * I + (1 - X) * J`. -/
theorem inf_eq_comap_C (I J : Ideal R) :
    I ⊓ J = (span {X} * I.map C ⊔ span {1 - X} * J.map C).comap (C : R →+* R[X]) := by
  have heval (r : R) : (evalRingHom r).comp (C : R →+* R[X]) = RingHom.id R := by
    simpa only [evalRingHom] using eval₂RingHom_comp_C (RingHom.id R) r
  apply le_antisymm
  · intro x hx
    have hI := mul_mem_mul (subset_span (Set.mem_singleton X)) (mem_map_of_mem C hx.1)
    have hJ := mul_mem_mul (subset_span (Set.mem_singleton (1 - X))) (mem_map_of_mem C hx.2)
    have hsum := add_mem (mem_sup_left hI) (mem_sup_right hJ)
    simpa [mem_comap, sub_mul] using hsum
  · intro x hx
    constructor
    · have h := mem_map_of_mem (evalRingHom (1 : R)) (mem_comap.mp hx)
      simpa [map_sup, Ideal.map_mul, map_span, map_map, heval] using h
    · have h := mem_map_of_mem (evalRingHom (0 : R)) (mem_comap.mp hx)
      simpa [map_sup, Ideal.map_mul, map_span, map_map, heval] using h

/-- For chosen generating sets of two ideals, the added-variable intersection ideal is
explicitly generated by `X * C f` and `(1 - X) * C g`. -/
theorem span_inf_span_eq_comap_C (s t : Set R) :
    span s ⊓ span t =
      (span ((fun f ↦ X * C f) '' s ∪ (fun g ↦ (1 - X) * C g) '' t)).comap
        (C : R →+* R[X]) := by
  rw [inf_eq_comap_C, map_span, map_span, span_mul_span, span_mul_span, ← span_union]
  simp only [Set.singleton_mul, Set.image_image]

/-- **Saturation by an added variable.** An element `x` lies in the contraction along `C` of
`I[X] + (r X - 1)` if and only if some power of `r` multiplies it into `I`. -/
theorem mem_comap_C_map_C_sup_span_C_mul_X_sub_one_iff {I : Ideal R} {r x : R} :
    x ∈ (I.map C ⊔ span {C r * X - 1}).comap (C : R →+* R[X]) ↔ ∃ n : ℕ, r ^ n * x ∈ I := by
  have := IsLocalization.adjoin_inv r
  let π := AdjoinRoot.mk (C r * X - 1)
  -- The added-variable ideal is the preimage of the extension of `I` to `R[X] ⧸ (r X - 1)`,
  -- which is the localization of `R` away from `r`.
  have hJ : I.map C ⊔ span {C r * X - 1} = ((I.map C).map π).comap π := by
    rw [comap_map_of_surjective _ AdjoinRoot.mk_surjective, ← RingHom.ker_eq_comap_bot]
    congr 1
    ext g
    rw [RingHom.mem_ker, AdjoinRoot.mk_eq_zero, mem_span_singleton]
  have hπC : π.comp C = algebraMap R (AdjoinRoot (C r * X - 1)) := by
    ext x
    simp [π, AdjoinRoot.algebraMap_eq]
  rw [hJ, comap_comap, map_map, hπC, mem_comap,
    IsLocalization.Away.algebraMap_mem_map_algebraMap_iff r]

/-- The contraction along `C` of `I[X] + (r X - 1)` is the contraction of `I` from the
localization `S` of `R` away from `r`. -/
theorem comap_C_map_C_sup_span_C_mul_X_sub_one (I : Ideal R) (r : R) (S : Type*) [CommSemiring S]
    [Algebra R S] [IsLocalization.Away r S] :
    (I.map C ⊔ span {C r * X - 1}).comap (C : R →+* R[X]) =
      (I.map (algebraMap R S)).comap (algebraMap R S) := by
  ext x
  rw [mem_comap_C_map_C_sup_span_C_mul_X_sub_one_iff, mem_comap,
    IsLocalization.Away.algebraMap_mem_map_algebraMap_iff r]

/-- For a prime element `ϖ`, the residues `t` modulo `ϖ` for which
`ϖ ^ 4` divides `(ϖ t)³ + a₂ (ϖ t)² + a₄ (ϖ t) + a₆` are among the roots of a nonzero polynomial of
degree at most `3` over `R ⧸ (ϖ)`: the first nonzero coefficient of `a₆, a₄ ϖ, a₂ ϖ², ϖ³`
modulo `ϖ⁴` gives the polynomial, which is monic when `ϖ` divides `a₂`, `a₄` and `a₆`. -/
theorem exists_poly_isRoot_mk_of_pow_four_dvd_cubic [IsDomain R] {ϖ : R} (hϖ : _root_.Prime ϖ)
    (a₂ a₄ a₆ : R) :
    ∃ p : (R ⧸ Ideal.span {ϖ})[X], p ≠ 0 ∧ p.natDegree ≤ 3 ∧ ∀ t : R,
      ϖ ^ 4 ∣ (ϖ * t) ^ 3 + a₂ * (ϖ * t) ^ 2 + a₄ * (ϖ * t) + a₆ →
        p.IsRoot (Ideal.Quotient.mk _ t) := by
  have : (Ideal.span {ϖ}).IsPrime := (Ideal.span_singleton_prime hϖ.ne_zero).2 hϖ
  have hm (x : R) (hx : ϖ ∣ x) : Ideal.Quotient.mk (Ideal.span {ϖ}) x = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.mem_span_singleton.2 hx)
  have hm' (x : R) (hx : Ideal.Quotient.mk (Ideal.span {ϖ}) x = 0) : ϖ ∣ x :=
    Ideal.mem_span_singleton.1 (Ideal.Quotient.eq_zero_iff_mem.1 hx)
  have cancel (k n : ℕ) (x z : R) (h : ϖ ^ (k + n) ∣ z) (e : z = ϖ ^ k * x) : ϖ ^ n ∣ x := by
    rw [e, pow_add] at h
    exact (mul_dvd_mul_iff_left (pow_ne_zero _ hϖ.ne_zero)).1 h
  have step (x y z : R) (h : ϖ ∣ z) (e : z = ϖ * x + y) : ϖ ∣ y :=
    (dvd_add_right (dvd_mul_right ϖ x)).1 (e ▸ h)
  by_cases h6 : ϖ ∣ a₆
  swap
  · refine ⟨1, one_ne_zero, by simp, fun t h ↦ (h6 ?_).elim⟩
    exact step (ϖ ^ 2 * t ^ 3 + a₂ * ϖ * t ^ 2 + a₄ * t) a₆ _
      ((dvd_pow_self ϖ (by norm_num : 4 ≠ 0)).trans h) (by ring)
  obtain ⟨b, rfl⟩ := h6
  have hG (t : R) (h : ϖ ^ 4 ∣ (ϖ * t) ^ 3 + a₂ * (ϖ * t) ^ 2 + a₄ * (ϖ * t) + ϖ * b) :
      ϖ ∣ ϖ ^ 2 * t ^ 3 + a₂ * ϖ * t ^ 2 + a₄ * t + b :=
    (dvd_pow_self ϖ (by norm_num : 3 ≠ 0)).trans (cancel 1 3 _ _ h (by ring))
  by_cases h4 : ϖ ∣ a₄
  swap
  · refine ⟨C (Ideal.Quotient.mk _ a₄) * X + C (Ideal.Quotient.mk _ b), ?_, by compute_degree!,
      fun t h ↦ ?_⟩
    · intro h0
      have := congrArg (fun q ↦ q.coeff 1) h0
      simp only [coeff_add, coeff_C_mul, coeff_X_one, coeff_C, coeff_zero] at this
      exact h4 (hm' _ (by simpa using this))
    · simpa [IsRoot.def, map_add, map_mul, map_pow] using
        hm _ (step (ϖ * t ^ 3 + a₂ * t ^ 2) (a₄ * t + b) _ (hG t h) (by ring))
  obtain ⟨c, rfl⟩ := h4
  by_cases hb : ϖ ∣ b
  swap
  · refine ⟨1, one_ne_zero, by simp, fun t h ↦ (hb ?_).elim⟩
    exact step (ϖ * t ^ 3 + a₂ * t ^ 2 + c * t) b _ (hG t h) (by ring)
  obtain ⟨d, rfl⟩ := hb
  have hH (t : R) (h : ϖ ^ 4 ∣ (ϖ * t) ^ 3 + a₂ * (ϖ * t) ^ 2 + ϖ * c * (ϖ * t) + ϖ * (ϖ * d)) :
      ϖ ^ 2 ∣ ϖ * t ^ 3 + a₂ * t ^ 2 + c * t + d := cancel 2 2 _ _ h (by ring)
  have hH1 (t : R) (h : ϖ ^ 4 ∣ (ϖ * t) ^ 3 + a₂ * (ϖ * t) ^ 2 + ϖ * c * (ϖ * t) +
      ϖ * (ϖ * d)) : ϖ ∣ ϖ * t ^ 3 + a₂ * t ^ 2 + c * t + d :=
    (dvd_pow_self ϖ (by norm_num : 2 ≠ 0)).trans (hH t h)
  by_cases h2 : ϖ ∣ a₂
  swap
  · refine ⟨C (Ideal.Quotient.mk _ a₂) * X ^ 2 + C (Ideal.Quotient.mk _ c) * X +
      C (Ideal.Quotient.mk _ d), ?_, by compute_degree!, fun t h ↦ ?_⟩
    · intro h0
      have := congrArg (fun q ↦ q.coeff 2) h0
      simp only [coeff_add, coeff_C_mul, coeff_X_pow, coeff_X, coeff_C, coeff_zero] at this
      exact h2 (hm' _ (by simpa using this))
    · have := hm _ (step (t ^ 3) (a₂ * t ^ 2 + c * t + d) _ (hH1 t h) (by ring))
      rw [map_add, map_add, map_mul, map_mul, map_pow] at this
      simpa [IsRoot.def] using this
  obtain ⟨e, rfl⟩ := h2
  by_cases hc : ϖ ∣ c
  swap
  · refine ⟨C (Ideal.Quotient.mk _ c) * X + C (Ideal.Quotient.mk _ d), ?_, by compute_degree!,
      fun t h ↦ ?_⟩
    · intro h0
      have := congrArg (fun q ↦ q.coeff 1) h0
      simp only [coeff_add, coeff_C_mul, coeff_X_one, coeff_C, coeff_zero] at this
      exact hc (hm' _ (by simpa using this))
    · simpa [IsRoot.def, map_add, map_mul, map_pow] using
        hm _ (step (t ^ 3 + e * t ^ 2) (c * t + d) _ (hH1 t h) (by ring))
  obtain ⟨f, rfl⟩ := hc
  by_cases hd : ϖ ∣ d
  swap
  · refine ⟨1, one_ne_zero, by simp, fun t h ↦ (hd ?_).elim⟩
    exact step (t ^ 3 + e * t ^ 2 + f * t) d _ (hH1 t h) (by ring)
  obtain ⟨g, rfl⟩ := hd
  have hmon : (X ^ 3 + C (Ideal.Quotient.mk (Ideal.span {ϖ}) e) * X ^ 2 +
      C (Ideal.Quotient.mk (Ideal.span {ϖ}) f) * X +
      C (Ideal.Quotient.mk (Ideal.span {ϖ}) g)).Monic := by monicity!
  refine ⟨_, hmon.ne_zero, by compute_degree!, fun t h ↦ ?_⟩
  have h1 : ϖ ∣ t ^ 3 + e * t ^ 2 + f * t + g := by
    simpa using cancel 1 1 (t ^ 3 + e * t ^ 2 + f * t + g)
      (ϖ * t ^ 3 + ϖ * e * t ^ 2 + ϖ * f * t + ϖ * g) (hH t h) (by ring)
  simpa [IsRoot.def] using hm _ h1

end Ideal
